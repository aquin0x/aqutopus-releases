# =====================================================================
# Monomem Üretim Ortam Değişkenleri (.env.example)
# https://monomem-release.frax.tr
#
# Bu dosyayı `.env` olarak kopyalayın:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. Güvenlik ve Gizli Anahtarlar (ZORUNLU)
# ---------------------------------------------------------------------
# 32 karakter veya daha uzun rastgele dizgiler kullanın.
# (install.sh bu anahtarları sizin için otomatik ve güvenli üretir)

# PostgreSQL veritabanı parolası
POSTGRES_PASSWORD=degistir_guclu_db_parolasi_32karakter

# MCP (Model Context Protocol) token imzalama anahtarı
MCP_SIGNING_KEY=degistir_guclu_mcp_imza_anahtari_32karakter

# Next.js uygulama oturum ve durum şifreleme anahtarı
APP_STATE_SECRET=degistir_guclu_app_durum_anahtari_32karakter

# ---------------------------------------------------------------------
# 2. Veritabanı Yapılandırması
# ---------------------------------------------------------------------
POSTGRES_USER=office
POSTGRES_DB=office

# ---------------------------------------------------------------------
# 3. Portlar ve Alan Adları (URL)
# ---------------------------------------------------------------------
# Dışarıya açılan portlar (çakışma varsa değiştirebilirsiniz)
APP_PORT=3000
CORE_PORT=8788

# Panel ve Uygulama dış erişim adresleri (Domaininiz varsa buraya yazın)
PANEL_URL=http://localhost:8788
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 4. Yapay Zekâ & RAG Sağlayıcıları (İsteğe Bağlı)
# ---------------------------------------------------------------------
# Hibrit RAG (vektör arama) ve ücretsiz gömme (embedding) için Gemini API anahtarı:
# https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------
# 5. Telegram Bildirim & Hızlı Onay Botu (İsteğe Bağlı)
# ---------------------------------------------------------------------
# @BotFather üzerinden alınan bot token'ı
TELEGRAM_BOT_TOKEN=

# Kendi kullanıcı ID'niz (@userinfobot ile öğrenebilirsiniz)
TELEGRAM_OWNER_ID=

# ---------------------------------------------------------------------
# 6. Sistem ve Saat Dilimi
# ---------------------------------------------------------------------
TZ=Europe/Istanbul
